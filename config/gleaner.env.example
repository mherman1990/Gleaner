# Copy to <data dir>/gleaner.env  (on Umbrel: ~/umbrel/app-data/herman-gleaner/data/gleaner.env)
ANTHROPIC_API_KEY=
# Long random string (e.g. `openssl rand -hex 32`). /api, used by Claude and scripts, is disabled until it's set.
GLEANER_API_TOKEN=
# Optional delivery targets
GLEANER_TEAMS_WEBHOOK=
GLEANER_NTFY_URL=
