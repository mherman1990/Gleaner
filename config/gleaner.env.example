# Copy to <data dir>/gleaner.env  (on Umbrel: ~/umbrel/app-data/herman-gleaner/data/gleaner.env)
ANTHROPIC_API_KEY=
# Optional, the v0.1 single API token: it works through v0.2.x as client "legacy" (every scope, all work). Give each
# client its own token instead with `node src/cli.js token add` (README → API). /api is disabled with neither.
GLEANER_API_TOKEN=
# Optional delivery targets
GLEANER_TEAMS_WEBHOOK=
GLEANER_NTFY_URL=
